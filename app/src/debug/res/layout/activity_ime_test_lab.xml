<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="openIME 输入框测试实验室（仅 Debug）"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/lab_single"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="单行普通文本"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            android:id="@+id/lab_multiline"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:gravity="top|start"
            android:hint="多行文本"
            android:imeOptions="actionNone"
            android:importantForAutofill="no"
            android:inputType="textMultiLine" />

        <EditText
            android:id="@+id/lab_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="密码输入框"
            android:importantForAutofill="no"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/lab_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="数字输入框"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/lab_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="电话输入框"
            android:importantForAutofill="no"
            android:inputType="phone" />

        <EditText
            android:id="@+id/lab_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="邮箱输入框"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/lab_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="URL 输入框"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/lab_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="搜索框"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            android:id="@+id/lab_chat"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="12dp"
            android:gravity="top|start"
            android:hint="聊天输入框（发送）"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine" />

        <EditText
            android:id="@+id/lab_form_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="表单：下一项"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            android:id="@+id/lab_form_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="表单：完成"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            android:id="@+id/lab_long_text"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:gravity="top|start"
            android:hint="已有 1 万字的长文本框"
            android:imeOptions="actionNone"
            android:importantForAutofill="no"
            android:inputType="textMultiLine" />

        <EditText
            android:id="@+id/lab_replace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="预选文字替换输入框"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="text" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setup_page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:focusableInTouchMode="true"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="32dp">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_setup_icon_ring"
            android:importantForAccessibility="no">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_launcher"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/setup_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/main_description"
            android:textColor="@color/setup_body"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/setup_enable"
            android:textColor="@color/setup_title"
            android:textSize="15sp"
            android:accessibilityLiveRegion="polite" />

        <LinearLayout
            android:id="@+id/open_ime_settings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_setup_primary_pill"
            android:clickable="true"
            android:contentDescription="@string/open_ime_settings"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">
            <TextView
                android:id="@+id/open_ime_settings_mark"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_setup_mark"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/setup_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/open_ime_settings_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/open_ime_settings"
                android:textColor="@color/setup_on_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/open_ime_settings_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/setup_on_primary"
                android:textSize="22sp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/choose_ime"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_setup_muted_pill"
            android:clickable="true"
            android:contentDescription="@string/choose_ime"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">
            <TextView
                android:id="@+id/choose_ime_mark"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_setup_mark"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/setup_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/choose_ime_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/choose_ime"
                android:textColor="@color/setup_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/choose_ime_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/setup_body"
                android:textSize="22sp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_setup_input"
            android:orientation="vertical"
            android:padding="18dp">
            <EditText
                android:id="@+id/test_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setup_test_field"
                android:hint="@string/test_hint"
                android:textColorHint="@color/setup_muted_text"
                android:textColor="@color/setup_title"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top|start"
                android:minLines="3"
                android:maxLines="6"
                android:importantForAutofill="no"
                android:minHeight="72dp"
                android:textSize="17sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/typing_tips"
                android:textColor="@color/setup_body"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/open_app_settings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_setup_muted_pill"
            android:clickable="true"
            android:contentDescription="@string/open_app_settings"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/open_app_settings"
                android:textColor="@color/setup_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/setup_body"
                android:textSize="22sp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/voice_permission"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_setup_muted_pill"
            android:clickable="true"
            android:contentDescription="@string/voice_permission_enable"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">
            <TextView
                android:id="@+id/voice_permission_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/voice_permission_enable"
                android:textColor="@color/setup_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/voice_permission_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/setup_body"
                android:textSize="22sp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/voice_permission_description"
            android:textColor="@color/setup_body"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>
</ScrollView>

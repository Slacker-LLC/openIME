<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/setup_page_bg" android:focusableInTouchMode="true">
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="44dp" android:paddingBottom="16dp">
<ImageView android:layout_width="72dp" android:layout_height="72dp" android:layout_gravity="center_horizontal" android:src="@drawable/ic_brand_mark" android:importantForAccessibility="no"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="openIME" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_display" android:fontFamily="sans-serif-medium" android:gravity="center"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="本地拼音输入法\n词库和语音都在设备内运行" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_body" android:gravity="center" android:lineSpacingExtra="4dp"/>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp" android:background="@drawable/bg_setup_card">
<LinearLayout android:id="@+id/open_ime_settings" android:layout_width="match_parent" android:layout_height="68dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true">
 <TextView android:id="@+id/open_ime_settings_mark" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="1" android:textSize="@dimen/ime_text_body" android:fontFamily="sans-serif-medium"/>
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
 <TextView android:id="@+id/open_ime_settings_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="启用输入法" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_title" android:fontFamily="sans-serif-medium"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="在系统设置中打开 openIME" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_small" android:layout_marginTop="2dp"/>
 </LinearLayout>
 <ImageView android:id="@+id/open_ime_settings_chevron" android:layout_width="24dp" android:layout_height="24dp" android:rotation="180" android:src="@drawable/ic_arrow_back" android:tint="@color/setup_body"/>
 </LinearLayout>
<View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/setup_input_line" android:alpha="0.25"/>
<LinearLayout android:id="@+id/choose_ime" android:layout_width="match_parent" android:layout_height="68dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true">
 <TextView android:id="@+id/choose_ime_mark" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="2" android:textSize="@dimen/ime_text_body" android:fontFamily="sans-serif-medium"/>
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
 <TextView android:id="@+id/choose_ime_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="切换到 openIME" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_title" android:fontFamily="sans-serif-medium"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="选择此键盘输入法" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_small" android:layout_marginTop="2dp"/>
 </LinearLayout>
 <ImageView android:id="@+id/choose_ime_chevron" android:layout_width="24dp" android:layout_height="24dp" android:rotation="180" android:src="@drawable/ic_arrow_back" android:tint="@color/setup_body"/>
 </LinearLayout>
<View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/setup_input_line" android:alpha="0.25"/>
<LinearLayout android:id="@+id/test_step" android:layout_width="match_parent" android:layout_height="68dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true">
 <TextView android:id="@+id/test_step_mark" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="3" android:textSize="@dimen/ime_text_body" android:fontFamily="sans-serif-medium"/>
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
 <TextView android:id="@+id/test_step_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="试打" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_title" android:fontFamily="sans-serif-medium"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="输入 nihao 得到你好；点候选上屏，点空格选首选" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_small" android:layout_marginTop="2dp"/>
 </LinearLayout>
 <ImageView android:id="@+id/test_step_chevron" android:layout_width="24dp" android:layout_height="24dp" android:rotation="180" android:src="@drawable/ic_arrow_back" android:tint="@color/setup_body"/>
 </LinearLayout>
</LinearLayout>
<EditText android:id="@+id/test_input" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:hint="在这里试打" android:background="@drawable/bg_setup_test_field" android:paddingHorizontal="16dp" android:inputType="textMultiLine|textCapSentences" android:textColor="@color/setup_title" android:textColorHint="@color/setup_muted_text" android:textSize="@dimen/ime_text_title" android:importantForAutofill="no"/>
<LinearLayout android:id="@+id/voice_permission_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/bg_setup_card" android:padding="16dp">
<LinearLayout android:id="@+id/voice_permission" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:clickable="true" android:focusable="true">
<TextView android:id="@+id/voice_permission_mark" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:text="♩"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
<TextView android:id="@+id/voice_permission_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="语音输入（可选）" android:fontFamily="sans-serif-medium" android:textSize="@dimen/ime_text_title" android:textColor="@color/setup_title"/>
<TextView android:id="@+id/voice_permission_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="需要麦克风权限；音频只在本机处理，不会上传。" android:textSize="@dimen/ime_text_small" android:textColor="@color/setup_body"/>
</LinearLayout>
<ImageView android:id="@+id/voice_permission_chevron" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_arrow_back" android:rotation="180"/>
</LinearLayout>
<LinearLayout android:id="@+id/voice_permission_actions" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginStart="44dp" android:layout_marginTop="12dp" android:orientation="horizontal">
<TextView android:id="@+id/voice_permission_authorize" android:layout_width="66dp" android:layout_height="38dp" android:text="授权" android:textSize="@dimen/ime_text_body" android:fontFamily="sans-serif-medium" android:gravity="center" android:textColor="@color/setup_title" android:clickable="true" android:focusable="true"/>
<TextView android:id="@+id/voice_permission_skip" android:layout_width="72dp" android:layout_height="38dp" android:layout_marginStart="10dp" android:text="跳过" android:textSize="@dimen/ime_text_body" android:gravity="center" android:textColor="@color/setup_primary" android:clickable="true" android:focusable="true"/>
</LinearLayout>
</LinearLayout>
</LinearLayout></ScrollView>
<LinearLayout android:id="@+id/open_app_settings" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="16dp" android:layout_marginVertical="16dp" android:gravity="center" android:clickable="true" android:focusable="true">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="打开偏好设置" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_title" android:fontFamily="sans-serif-medium"/>
</LinearLayout></LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/setup_page_bg" android:focusableInTouchMode="true">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:id="@+id/main_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:orientation="vertical" android:paddingHorizontal="@dimen/ime_space_lg" android:paddingTop="@dimen/ime_space_lg" android:paddingBottom="@dimen/ime_space_lg">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_vertical" android:src="@drawable/ic_brand_mark" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="openIME" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_glyph" android:fontFamily="sans-serif-medium" android:gravity="start" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="本地拼音 · 离线语音" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_small" android:gravity="start" android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="visible" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_small" android:layout_marginTop="@dimen/ime_space_md" android:lineSpacingExtra="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="键盘准备" android:paddingStart="@dimen/ime_space_lg" android:textSize="@dimen/ime_text_small" android:textColor="@color/setup_body" android:layout_marginTop="@dimen/ime_space_xl" android:layout_marginBottom="@dimen/ime_space_sm" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="0dp" >
                <LinearLayout android:id="@+id/open_ime_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true" android:minHeight="64dp" android:paddingTop="@dimen/ime_space_sm" android:paddingBottom="@dimen/ime_space_sm">
                    <TextView android:id="@+id/open_ime_settings_mark" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="1" android:textSize="@dimen/ime_text_body" android:fontFamily="sans-serif-medium" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:id="@+id/open_ime_settings_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="启用输入法" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_body" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="在系统设置中打开 openIME" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_small" android:layout_marginTop="@dimen/ime_space_xs" />
                    </LinearLayout>
                    <ImageView android:id="@+id/open_ime_settings_chevron" android:layout_width="24dp" android:layout_height="24dp" android:rotation="180" android:src="@drawable/ic_arrow_back" android:tint="@color/setup_body" />
                </LinearLayout>
                <Space android:layout_width="match_parent" android:layout_height="@dimen/ime_space_sm" />
                <LinearLayout android:id="@+id/choose_ime" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true" android:minHeight="64dp" android:paddingTop="@dimen/ime_space_sm" android:paddingBottom="@dimen/ime_space_sm">
                    <TextView android:id="@+id/choose_ime_mark" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="2" android:textSize="@dimen/ime_text_body" android:fontFamily="sans-serif-medium" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:id="@+id/choose_ime_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="切换到 openIME" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_body" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="选择此键盘输入法" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_small" android:layout_marginTop="@dimen/ime_space_xs" />
                    </LinearLayout>
                    <ImageView android:id="@+id/choose_ime_chevron" android:layout_width="24dp" android:layout_height="24dp" android:rotation="180" android:src="@drawable/ic_arrow_back" android:tint="@color/setup_body" />
                </LinearLayout>
                <Space android:layout_width="match_parent" android:layout_height="@dimen/ime_space_sm" />
                <LinearLayout android:id="@+id/test_step" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true" android:minHeight="64dp" android:paddingTop="@dimen/ime_space_sm" android:paddingBottom="@dimen/ime_space_sm">
                    <TextView android:id="@+id/test_step_mark" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="3" android:textSize="@dimen/ime_text_body" android:fontFamily="sans-serif-medium" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:id="@+id/test_step_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="试打" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_body" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="输入 nihao 得到你好；点候选上屏，点空格选首选" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_small" android:layout_marginTop="@dimen/ime_space_xs" />
                    </LinearLayout>
                    <ImageView android:id="@+id/test_step_chevron" android:layout_width="24dp" android:layout_height="24dp" android:rotation="180" android:src="@drawable/ic_arrow_back" android:tint="@color/setup_body" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="试一下你的键盘" android:paddingStart="@dimen/ime_space_lg" android:textSize="@dimen/ime_text_small" android:textColor="@color/setup_body" android:layout_marginTop="@dimen/ime_space_xl" android:layout_marginBottom="@dimen/ime_space_sm" />
            <EditText android:id="@+id/test_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:hint="输入拼音，或按住空格说话" android:background="@drawable/bg_setup_test_field" android:paddingHorizontal="16dp" android:inputType="textMultiLine|textCapSentences" android:textColor="@color/setup_title" android:textColorHint="@color/setup_muted_text" android:textSize="@dimen/ime_text_body" android:importantForAutofill="no" android:minHeight="56dp" android:paddingTop="16dp" android:paddingBottom="16dp" />
            <LinearLayout android:id="@+id/voice_permission_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ime_space_xl" android:orientation="vertical" android:paddingHorizontal="@dimen/ime_space_lg" android:paddingVertical="@dimen/ime_space_sm">
                <LinearLayout android:id="@+id/voice_permission" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:clickable="true" android:focusable="true">
                    <TextView android:id="@+id/voice_permission_mark" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="♩" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:id="@+id/voice_permission_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="语音输入（可选）" android:fontFamily="sans-serif-medium" android:textSize="@dimen/ime_text_body" android:textColor="@color/setup_title" />
                        <TextView android:id="@+id/voice_permission_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="需要麦克风权限；音频只在本机处理，不会上传。" android:textSize="@dimen/ime_text_small" android:textColor="@color/setup_body" android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                    <ImageView android:id="@+id/voice_permission_chevron" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_arrow_back" android:rotation="180" />
                </LinearLayout>
                <LinearLayout android:id="@+id/voice_permission_actions" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginStart="40dp" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <Button android:id="@+id/voice_permission_authorize" android:textAllCaps="false" android:elevation="0dp" android:stateListAnimator="@null" android:minWidth="0dp" android:layout_width="66dp" android:layout_height="48dp" android:text="授权" android:textSize="@dimen/ime_text_body" android:fontFamily="sans-serif-medium" android:gravity="center" android:textColor="@color/setup_title" android:clickable="true" android:focusable="true" />
                    <Button android:id="@+id/voice_permission_skip" android:textAllCaps="false" android:elevation="0dp" android:stateListAnimator="@null" android:minWidth="0dp" android:layout_width="72dp" android:layout_height="48dp" android:layout_marginStart="@dimen/ime_space_md" android:text="跳过" android:textSize="@dimen/ime_text_body" android:gravity="center" android:textColor="@color/setup_primary" android:clickable="true" android:focusable="true" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/open_app_settings" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginHorizontal="@dimen/ime_space_lg" android:layout_marginVertical="@dimen/ime_space_lg" android:paddingHorizontal="24dp" android:gravity="center" android:text="打开偏好设置" android:textColor="@android:color/white" android:textSize="@dimen/ime_text_title" android:textAllCaps="false" android:fontFamily="sans-serif-medium" android:elevation="0dp" android:stateListAnimator="@null" />
</LinearLayout>

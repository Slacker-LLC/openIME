<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setup_page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/ime_space_xl"
        android:paddingTop="@dimen/ime_space_xxl"
        android:paddingEnd="@dimen/ime_space_xl"
        android:paddingBottom="@dimen/ime_space_xxl">

        <ImageView
            android:layout_width="@dimen/setup_hero_mark_size"
            android:layout_height="@dimen/setup_hero_mark_size"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_brand_mark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ime_space_lg"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:text="@string/app_name"
            android:textColor="@color/setup_title"
            android:textSize="@dimen/ime_text_display"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ime_space_sm"
            android:gravity="center"
            android:text="@string/main_description"
            android:textColor="@color/setup_body"
            android:textSize="@dimen/ime_text_body" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ime_space_xl"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/setup_enable"
            android:textColor="@color/setup_title"
            android:textSize="@dimen/ime_text_body" />

        <LinearLayout
            android:id="@+id/open_ime_settings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/setup_touch_target"
            android:layout_marginTop="@dimen/ime_space_lg"
            android:clickable="true"
            android:contentDescription="@string/open_ime_settings"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ime_space_lg"
            android:paddingEnd="@dimen/ime_space_lg">

            <TextView
                android:id="@+id/open_ime_settings_mark"
                android:layout_width="@dimen/setup_step_mark_size"
                android:layout_height="@dimen/setup_step_mark_size"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="1"
                android:textColor="@color/setup_primary"
                android:textSize="@dimen/ime_text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/open_ime_settings_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ime_space_md"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:text="@string/open_ime_settings"
                android:textColor="@color/setup_title"
                android:textSize="@dimen/ime_text_title"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/open_ime_settings_chevron"
                android:layout_width="@dimen/setup_icon_size"
                android:layout_height="@dimen/setup_icon_size"
                android:importantForAccessibility="no"
                android:rotation="180"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/setup_body" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/choose_ime"
            android:layout_width="match_parent"
            android:layout_height="@dimen/setup_touch_target"
            android:layout_marginTop="@dimen/ime_space_md"
            android:clickable="true"
            android:contentDescription="@string/choose_ime"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ime_space_lg"
            android:paddingEnd="@dimen/ime_space_lg">

            <TextView
                android:id="@+id/choose_ime_mark"
                android:layout_width="@dimen/setup_step_mark_size"
                android:layout_height="@dimen/setup_step_mark_size"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="2"
                android:textColor="@color/setup_primary"
                android:textSize="@dimen/ime_text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/choose_ime_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ime_space_md"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:text="@string/choose_ime"
                android:textColor="@color/setup_title"
                android:textSize="@dimen/ime_text_title"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/choose_ime_chevron"
                android:layout_width="@dimen/setup_icon_size"
                android:layout_height="@dimen/setup_icon_size"
                android:importantForAccessibility="no"
                android:rotation="180"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/setup_body" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/voice_permission_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ime_space_md"
            android:background="@drawable/bg_setup_card"
            android:orientation="vertical"
            android:padding="@dimen/ime_space_sm">

            <LinearLayout
                android:id="@+id/voice_permission"
                android:layout_width="match_parent"
                android:layout_height="@dimen/setup_touch_target"
                android:clickable="true"
                android:contentDescription="@string/voice_permission_enable"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ime_space_sm"
                android:paddingEnd="@dimen/ime_space_sm">

                <TextView
                    android:id="@+id/voice_permission_mark"
                    android:layout_width="@dimen/setup_step_mark_size"
                    android:layout_height="@dimen/setup_step_mark_size"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="3"
                    android:textColor="@color/setup_primary"
                    android:textSize="@dimen/ime_text_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/voice_permission_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ime_space_md"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:text="@string/voice_permission_enable"
                    android:textColor="@color/setup_title"
                    android:textSize="@dimen/ime_text_title"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/voice_permission_chevron"
                    android:layout_width="@dimen/setup_icon_size"
                    android:layout_height="@dimen/setup_icon_size"
                    android:importantForAccessibility="no"
                    android:rotation="180"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/setup_body" />
            </LinearLayout>

            <TextView
                android:id="@+id/voice_permission_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ime_space_sm"
                android:layout_marginTop="@dimen/ime_space_xs"
                android:layout_marginEnd="@dimen/ime_space_sm"
                android:text="@string/voice_permission_description"
                android:textColor="@color/setup_body"
                android:textSize="@dimen/ime_text_body" />

            <TextView
                android:id="@+id/voice_permission_skip"
                android:layout_width="match_parent"
                android:layout_height="@dimen/setup_touch_target"
                android:layout_marginTop="@dimen/ime_space_sm"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/voice_permission_skip"
                android:textColor="@color/setup_primary"
                android:textSize="@dimen/ime_text_body"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/test_step_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ime_space_md"
            android:background="@drawable/bg_setup_card"
            android:orientation="vertical"
            android:padding="@dimen/ime_space_sm">

            <LinearLayout
                android:id="@+id/test_step"
                android:layout_width="match_parent"
                android:layout_height="@dimen/setup_touch_target"
                android:clickable="true"
                android:contentDescription="@string/test_step"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ime_space_sm"
                android:paddingEnd="@dimen/ime_space_sm">

                <TextView
                    android:id="@+id/test_step_mark"
                    android:layout_width="@dimen/setup_step_mark_size"
                    android:layout_height="@dimen/setup_step_mark_size"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="4"
                    android:textColor="@color/setup_primary"
                    android:textSize="@dimen/ime_text_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/test_step_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ime_space_md"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:text="@string/test_step"
                    android:textColor="@color/setup_title"
                    android:textSize="@dimen/ime_text_title"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/test_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ime_space_sm"
                android:background="@drawable/bg_setup_test_field"
                android:gravity="top|start"
                android:hint="@string/test_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="6"
                android:minLines="3"
                android:textColor="@color/setup_title"
                android:textColorHint="@color/setup_muted_text"
                android:textSize="@dimen/ime_text_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ime_space_sm"
                android:text="@string/typing_tips"
                android:textColor="@color/setup_body"
                android:textSize="@dimen/ime_text_body" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/open_app_settings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/setup_touch_target"
            android:layout_marginTop="@dimen/ime_space_lg"
            android:clickable="true"
            android:contentDescription="@string/open_app_settings"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ime_space_lg"
            android:paddingEnd="@dimen/ime_space_lg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:text="@string/open_app_settings"
                android:textColor="@color/setup_title"
                android:textSize="@dimen/ime_text_title"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="@dimen/setup_icon_size"
                android:layout_height="@dimen/setup_icon_size"
                android:importantForAccessibility="no"
                android:rotation="180"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/setup_body" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

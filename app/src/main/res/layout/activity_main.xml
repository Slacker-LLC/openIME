<?xml version="1.0" encoding="utf-8"?>
<!--
  Home page. Two states share one screen:
  - setup (onboarding_group): progress, three steps in one card, optional voice, and a bottom
    button that performs the current step;
  - ready (ready_group): a one-line ready card, the try-typing field, voice status and shortcuts.
  The voice block (voice_block) is moved between the two slots by MainActivity.
  Values follow docs/APP_UI_SPEC.md.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/setup_page_bg" android:focusableInTouchMode="true">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:id="@+id/main_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:orientation="vertical" android:paddingHorizontal="@dimen/ime_space_lg" android:paddingTop="28dp" android:paddingBottom="@dimen/ime_space_lg">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_brand_mark" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_glyph" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/home_tagline" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_detail" />
                </LinearLayout>
                <ImageButton android:id="@+id/open_settings_icon" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_pref_settings" android:tint="@color/setup_title" android:contentDescription="@string/settings_title" android:visibility="gone" />
            </LinearLayout>

            <!-- Setup state -->
            <LinearLayout android:id="@+id/onboarding_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="40dp" android:paddingHorizontal="@dimen/ime_space_xs" android:orientation="vertical">
                    <TextView android:id="@+id/setup_progress_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/setup_primary_text" android:textSize="@dimen/ime_text_detail" android:fontFamily="sans-serif-medium" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="10dp" android:orientation="horizontal" android:importantForAccessibility="noHideDescendants">
                        <View android:id="@+id/setup_progress_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                        <View android:id="@+id/setup_progress_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" />
                        <View android:id="@+id/setup_progress_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/setup_heading" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_heading" android:textStyle="bold" android:accessibilityHeading="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/setup_subheading" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_row" android:lineSpacingExtra="3dp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/steps_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:background="@drawable/bg_setup_card">
                    <LinearLayout android:id="@+id/open_ime_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingVertical="14dp" android:clickable="true" android:focusable="true">
                        <TextView android:id="@+id/open_ime_settings_mark" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="1" android:textSize="@dimen/ime_text_body" android:fontFamily="sans-serif-medium" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:id="@+id/open_ime_settings_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/open_ime_settings" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_title" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/open_ime_settings_hint" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_detail" />
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="56dp" android:background="@color/setup_hairline" />
                    <LinearLayout android:id="@+id/choose_ime" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingVertical="14dp" android:clickable="true" android:focusable="true">
                        <TextView android:id="@+id/choose_ime_mark" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="2" android:textSize="@dimen/ime_text_body" android:fontFamily="sans-serif-medium" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:id="@+id/choose_ime_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/choose_ime" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_title" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/choose_ime_hint" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_detail" />
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="56dp" android:background="@color/setup_hairline" />
                    <LinearLayout android:id="@+id/test_step" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingVertical="14dp" android:focusable="true">
                        <TextView android:id="@+id/test_step_mark" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="3" android:textSize="@dimen/ime_text_body" android:fontFamily="sans-serif-medium" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:id="@+id/test_step_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/test_step" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_title" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/test_step_hint" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_detail" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout android:id="@+id/onboarding_voice_slot" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:id="@+id/voice_block" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/voice_section_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="@dimen/ime_space_sm" android:paddingStart="@dimen/ime_space_lg" android:text="@string/section_optional" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_detail" android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" />
                        <LinearLayout android:id="@+id/voice_permission" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp" android:paddingVertical="12dp" android:background="@drawable/bg_setup_card" android:clickable="true" android:focusable="true">
                            <ImageView android:id="@+id/voice_permission_icon" android:layout_width="32dp" android:layout_height="32dp" android:padding="7dp" android:src="@drawable/ic_pref_mic" android:importantForAccessibility="no" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                                <TextView android:id="@+id/voice_permission_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/voice_title" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_row" android:fontFamily="sans-serif-medium" />
                                <TextView android:id="@+id/voice_permission_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/voice_permission_description" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_detail" android:lineSpacingExtra="2dp" />
                            </LinearLayout>
                            <Button android:id="@+id/voice_permission_authorize" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="12dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingHorizontal="18dp" android:text="@string/voice_permission_enable" android:textAllCaps="false" android:textSize="@dimen/ime_text_body" android:fontFamily="sans-serif-medium" android:elevation="0dp" android:stateListAnimator="@null" />
                            <TextView android:id="@+id/voice_permission_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:text="@string/voice_permission_ready" android:textColor="@color/setup_icon" android:textSize="@dimen/ime_text_small" android:fontFamily="sans-serif-medium" android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Ready state -->
            <LinearLayout android:id="@+id/ready_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:id="@+id/ready_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/bg_setup_card" android:focusable="true">
                    <ImageView android:id="@+id/ready_mark" android:layout_width="40dp" android:layout_height="40dp" android:padding="10dp" android:src="@drawable/ic_pref_check" android:tint="@android:color/white" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_ready" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_status" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/setup_ready_detail" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_detail" />
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="@dimen/ime_space_sm" android:paddingStart="@dimen/ime_space_lg" android:text="@string/section_try" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_detail" android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" />
                <EditText android:id="@+id/test_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:hint="@string/test_hint" android:paddingHorizontal="16dp" android:paddingVertical="14dp" android:inputType="textMultiLine|textCapSentences" android:textColor="@color/setup_title" android:textColorHint="@color/setup_muted_text" android:textSize="@dimen/ime_text_title" android:importantForAutofill="no" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:scrollbars="none" android:overScrollMode="never">
                    <LinearLayout android:id="@+id/typing_tips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tip_nihao" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_detail" android:paddingHorizontal="12dp" android:paddingVertical="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/tip_space" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_detail" android:paddingHorizontal="12dp" android:paddingVertical="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/tip_voice" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_detail" android:paddingHorizontal="12dp" android:paddingVertical="6dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <FrameLayout android:id="@+id/ready_voice_slot" android:layout_width="match_parent" android:layout_height="wrap_content" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="@dimen/ime_space_sm" android:paddingStart="@dimen/ime_space_lg" android:text="@string/section_shortcuts" android:textColor="@color/setup_body" android:textSize="@dimen/ime_text_detail" android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" />
                <LinearLayout android:id="@+id/shortcuts_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_setup_card">
                    <LinearLayout android:id="@+id/shortcut_preferences" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/settings_title">
                        <ImageView android:id="@+id/shortcut_preferences_icon" android:layout_width="32dp" android:layout_height="32dp" android:padding="7dp" android:src="@drawable/ic_pref_settings" android:importantForAccessibility="no" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/settings_title" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_row" android:fontFamily="sans-serif-medium" android:importantForAccessibility="no" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right" android:tint="@color/setup_chevron" android:importantForAccessibility="no" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="60dp" android:background="@color/setup_hairline" />
                    <LinearLayout android:id="@+id/shortcut_fuzzy" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/shortcut_fuzzy">
                        <ImageView android:id="@+id/shortcut_fuzzy_icon" android:layout_width="32dp" android:layout_height="32dp" android:padding="7dp" android:src="@drawable/ic_pref_fuzzy" android:importantForAccessibility="no" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/shortcut_fuzzy" android:textColor="@color/setup_title" android:textSize="@dimen/ime_text_row" android:fontFamily="sans-serif-medium" android:importantForAccessibility="no" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right" android:tint="@color/setup_chevron" android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/open_app_settings" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginHorizontal="@dimen/ime_space_lg" android:layout_marginTop="@dimen/ime_space_sm" android:layout_marginBottom="@dimen/ime_space_lg" android:paddingHorizontal="24dp" android:gravity="center" android:text="@string/open_ime_settings_action" android:textColor="@color/setup_on_primary" android:textSize="@dimen/ime_text_title" android:textAllCaps="false" android:fontFamily="sans-serif-medium" android:elevation="0dp" android:stateListAnimator="@null" />
</LinearLayout>
